{
  "alphabet": {
    "require": true,
    "uppercase": {
      "allow": true,
      "require": false
    },
    "lowercase": {
      "allow": true,
      "require": false
    }
  },
  "number": {
    "allow": true,
    "require": false
  },
  "specialCharacter": {
    "allow": true,
    "require": true
  },
  "length": {
    "min": 10,
    "max": 20
  }
}
