{
  "alphabetUppercase": {
    "allow": true,
    "require": false
  },
  "alphabetLowercase": {
    "allow": true,
    "require": true
  },
  "number": {
    "allow": true,
    "require": false
  },
  "specialCharacter": {
    "allow": true,
    "require": true
  },
  "length": {
    "min": 10,
    "max": 20
  }
}
