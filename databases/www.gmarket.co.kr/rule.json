{
  "alphabet": {
    "require": true,
    "uppercase": {
      "allow": true,
      "require": true
    },
    "lowercase": {
      "allow": true,
      "require": true
    }
  },
  "number": {
    "allow": true,
    "require": true
  },
  "specialCharacter": {
    "allow": true,
    "require": true,
    "usable": "!$%&()*+,-./:;<>=?@#[\\]^_{|}~"
  },
  "length": {
    "min": 8,
    "max": 15
  }
}
